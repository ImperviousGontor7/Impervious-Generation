# Application
NODE_ENV=development
PORT=5001
HOST=0.0.0.0

# API
API_URL=http://localhost:5001/api
CLIENT_URL=http://localhost:5174
CORS_ORIGIN=http://localhost:5174,http://localhost:5001

# PostgreSQL
DATABASE_URL=postgresql://postgres:change-this-password@localhost:5432/impervious?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=impervious

# JWT
JWT_ACCESS_SECRET=replace-with-random-access-secret
JWT_REFRESH_SECRET=replace-with-different-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Storage
STORAGE_PROVIDER=local
LOG_LEVEL=info
